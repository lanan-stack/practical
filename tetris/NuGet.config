<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 包源配置（放在解决方案根目录，对本解决方案内所有工程生效）

  为什么需要这个文件：
  Visual Studio 的"Google Test"项目模板所用的 gtest 包，并不是从网上下载的，
  而是随 VS 安装包一起放在本机的一个离线目录里。这里把这个离线目录登记成
  一个包源，好处是：即使断网，gtest 也能正常还原（restore），
  不必依赖 nuget.org。

  注意：下面这条路径与本机 VS 的安装位置绑定。如果以后换了电脑或重装 VS，
  路径会变，届时只要把 value 改成新机器上对应扩展目录下的 Packages 文件夹即可
  （也可以用 VS 的"工具 → NuGet 包管理器 → 包管理器设置"图形界面来改）。
-->
<configuration>
  <packageSources>
    <!-- VS 自带的 Google Test 离线包源（含 gtest 1.8.1.8） -->
    <add key="VS-GoogleTest-Offline"
         value="D:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\Extensions\o2gh2lwn.gwa\Packages" />
  </packageSources>
</configuration>
